      // ---------- move photo between albums ----------
      function openAlbumPicker(excludeSlug, cb) {
        const targets = albums.filter(a => !a._deleted && a.slug !== excludeSlug);
        if (!targets.length) { toast('No other album to move to — create one first.'); return; }
        const ov = el('div', 'fixed inset-0 z-[200] bg-black/85 grid place-items-center p-6');
        const box = el('div', 'bg-[var(--bg-color)] border border-[var(--border-color)] rounded-lg p-6 max-w-sm w-full');
        box.appendChild(el('h3', 'text-lg font-serif italic text-[var(--color-brand-primary)] mb-4', 'Move photo to…'));
        const list = el('div', 'space-y-1.5 max-h-[50vh] overflow-auto');
        targets.forEach(t => {
          const b = el('button', 'w-full text-left px-3 py-2 rounded border border-[var(--border-color)] hover:border-[var(--color-brand-primary)] hover:text-[var(--color-brand-primary)] transition text-sm', `${t.title || t.slug} <span class="text-[var(--text-muted)]">· ${t.photos.length}</span>`);
          b.onclick = () => { ov.remove(); cb(t.slug); };
          list.appendChild(b);
        });
        box.appendChild(list);
        const cancel = el('button', 'mt-4 text-xs uppercase tracking-widest text-[var(--text-muted)] hover:text-[var(--text-color)]', 'Cancel');
        cancel.onclick = () => ov.remove(); box.appendChild(cancel);
        ov.appendChild(box); document.body.appendChild(ov);
