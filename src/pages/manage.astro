      function performMove(from, photo, toSlug) {
        const to = albums.find(a => a.slug === toSlug); if (!to) return;
        // ensure unique filename in the destination
        let name = photo.file; const existing = new Set(to.photos.map(p => p.file));
        if (existing.has(name)) { const base = name.replace(/\.[^.]+$/, ''), ext = name.slice(base.length); let i = 1; while (existing.has(`${base}_${i}${ext}`)) i++; name = `${base}_${i}${ext}`; }
        const moved = { file: name, caption: photo.caption || '', featured: !!photo.featured, published: photo.published !== false };
        if (photo._new) { moved._new = true; moved._base64 = photo._base64; moved._url = photo._url; }
        else { moved._movedFrom = { slug: from.slug, file: photo.file }; moved._url = `${RAW}/content/albums/${from.slug}/${photo.file}`; }
        const idx = from.photos.indexOf(photo); from.photos.splice(idx, 1);
        if (from.cover === photo.file) from.cover = from.photos[0] ? from.photos[0].file : '';
