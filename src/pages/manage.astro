      }

      // ---------- uploads (resize client-side) ----------
      async function handleUpload(a, fileList) {
        const files = Array.from(fileList); if (!files.length) return;
        toast(`Processing ${files.length} photo${files.length === 1 ? '' : 's'}…`, 4000);
        for (const f of files) {
          if (!f.type.startsWith('image/')) continue;
          try {
            const { base64, dataUrl } = await resizeImage(f);
            let name = f.name.replace(/\.[^.]+$/, '').replace(/[^a-zA-Z0-9_-]+/g, '_') + '.jpg';
            const existing = new Set(a.photos.map(p => p.file));
            let n = name, i = 1; while (existing.has(n)) n = name.replace('.jpg', `_${i++}.jpg`);
            a.photos.push({ file: n, caption: '', featured: false, published: true, _new: true, _base64: base64, _url: dataUrl });
            if (!a.cover) a.cover = n;
          } catch (err) { toast('Skipped one image: ' + err.message); }
        }
        markDirty(a); renderEditor(); renderSidebar();
        toast('Photos added — click Save & Publish when ready.');
      }

      async function resizeImage(file) {
        const bmp = await createImageBitmap(file, { imageOrientation: 'from-image' }).catch(() => createImageBitmap(file));
        let { width, height } = bmp;
        const scale = Math.min(1, MAX_EDGE / Math.max(width, height));
        width = Math.round(width * scale); height = Math.round(height * scale);
        const canvas = document.createElement('canvas'); canvas.width = width; canvas.height = height;
        canvas.getContext('2d').drawImage(bmp, 0, 0, width, height);
        const blob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', JPEG_Q));
        const dataUrl = await new Promise(r => { const fr = new FileReader(); fr.onload = () => r(fr.result); fr.readAsDataURL(blob); });
        return { base64: dataUrl.split(',')[1], dataUrl };
      }

      // ---------- new / delete album ----------
      function newAlbum() {
        const title = prompt('Album title?'); if (!title) return;
